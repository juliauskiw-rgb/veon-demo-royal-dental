---
import CallButton from "./CallButton.astro";
import { img, nb } from "../data/site";
const B = import.meta.env.BASE_URL;
const H1 = "Естетична стоматологія у Львові: спершу фотопротокол і цифровий план, потім лікування";
const wide = img["hero-models"];
const sq = img["hero-models-sq"];
const srcset = (files: typeof wide) => files.map((f) => `${B}images/${f.file} ${f.width}w`).join(", ");
const wideLast = wide[wide.length - 1];
const sqLast = sq[sq.length - 1];
---
<section id="hero" class="hero" data-rec="R-001,R-004">
  <div class="container text">
    <h1>{nb(H1)}</h1>
    <div class="seam">
      <p class="lede">{nb("Цифрова клініка на вул. Героїв Крут, 11б: фотопротокол, Digital Smile Design і лікування під мікроскопом.")}</p>
      <div class="actions">
        <CallButton class="hero-cta" />
        <a class="link" href="#method">Ціни та перший візит</a>
      </div>
    </div>
  </div>
  <figure class="band on-dark">
    <div class="band__frame">
      <picture>
        <source media="(max-width: 47.99rem)" srcset={srcset(sq)} sizes="100vw" width={sqLast.width} height={sqLast.height} />
        <img
          src={`${B}images/${wide[1].file}`}
          srcset={srcset(wide)}
          sizes="100vw"
          width={wideLast.width}
          height={wideLast.height}
          alt="Керамічні вініри і блоки Empress CAD Multi на чорному тлі, фото клініки Royal Dental"
          fetchpriority="high"
          decoding="sync"
        />
      </picture>
    </div>
    <figcaption class="container caption">Етапи виготовлення керамічних вінірів Empress CAD Multi</figcaption>
  </figure>
</section>

<style>
  .hero { padding-top: clamp(var(--space-3), 4vw, var(--space-5)); }
  .text { display: grid; gap: clamp(var(--space-3), 3vw, var(--space-4)); padding-bottom: clamp(var(--space-3), 3vw, var(--space-4)); }
  h1 {
    font-size: var(--text-h1); line-height: var(--lh-tight); letter-spacing: -0.02em; font-weight: 500;
    max-width: 25ch; text-wrap: balance; font-variation-settings: "opsz" 72;
  }
  .seam { display: grid; gap: var(--space-3); align-items: end; }
  .lede { max-width: 40ch; color: var(--color-text-muted); font-size: var(--text-s); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  .band { background: var(--color-dark); color: var(--color-silver); }
  .band__frame { overflow: hidden; }
  .band img {
    width: 100%; height: clamp(15rem, 34svh, 22rem); object-fit: cover; object-position: 50% 45%;
    max-width: 1920px; margin-inline: auto;
    animation: band-reveal var(--dur-long) var(--ease-out) both;
  }
  .caption { padding-block: var(--space-2) var(--space-3); font-size: var(--text-xs); color: var(--color-silver); }
  @keyframes band-reveal { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }

  @media (min-width: 64rem) {
    .seam { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); }
    .actions { justify-content: flex-end; }
    .lede { font-size: var(--text-m); line-height: 1.4; max-width: 30ch; }
  }
  @media (max-width: 47.99rem) {
    .actions { flex-direction: column; align-items: stretch; gap: var(--space-1); }
    .actions .link { align-self: flex-start; }
    .band img { height: auto; aspect-ratio: 1 / 1; animation-duration: 600ms; }
  }
  @media (prefers-reduced-motion: reduce) {
    .band img { animation: none; }
  }
</style>
