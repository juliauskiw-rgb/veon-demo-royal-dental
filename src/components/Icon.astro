---
// Inline line icons (one set, drawn for this site). Decorative: hidden from assistive tech.
interface Props { name: "phone" | "mail" | "pin" | "menu" | "close" | "chev-left" | "chev-right" | "plus"; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M6.6 3.5h2.6l1.4 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === "mail" && <><rect x="3" y="5.5" width="18" height="13" rx="1.5" /><path d="m3.8 6.5 8.2 6.2 8.2-6.2" /></>}
  {name === "pin" && <><path d="M12 21s-6.5-6.1-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.9 12 21 12 21Z" /><circle cx="12" cy="9.8" r="2.3" /></>}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "chev-left" && <path d="m14.5 6-6 6 6 6" />}
  {name === "chev-right" && <path d="m9.5 6 6 6-6 6" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
</svg>
