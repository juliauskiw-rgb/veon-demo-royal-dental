---
import CallButton from "./CallButton.astro";
import FutureLink from "./FutureLink.astro";
import { pricesUah, pricesEur, nb } from "../data/site";
const cols = [
  { title: "У гривнях", items: pricesUah },
  { title: "У євро", items: pricesEur },
];
---
<section id="prices" class="section prices" data-rec="R-009">
  <div class="container grid">
    <div class="intro">
      <h2>Ціни</h2>
      <p>{nb("За прайсом клініки. Остаточна вартість — після консультації.")}</p>
    </div>
    <div class="sheet">
      {cols.map((c) => (
        <div class="col">
          <h3>{c.title}</h3>
          <ul>
            {c.items.map((it) => (
              <li><span class="svc">{nb(it.name)}</span><span class="price">{it.price}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="after">
      <CallButton label="Записатися на консультацію" withNumber={false} />
      <FutureLink>Повний прайс</FutureLink>
    </div>
  </div>
</section>

<style>
  .prices { padding-block: var(--space-6) var(--space-5); }
  .grid { display: grid; gap: var(--space-4); }
  .intro { display: grid; gap: var(--space-3); }
  .intro p { color: var(--color-text-muted); max-width: 46ch; }
  .sheet { display: grid; gap: var(--space-4); padding: var(--space-4) var(--space-3); background: var(--color-surface); border-radius: var(--radius); }
  .col h3 { font-size: var(--text-xs); font-weight: 600; color: var(--color-text-muted); padding-bottom: var(--space-1); border-bottom: 1px solid var(--color-text); }
  .col ul { list-style: none; }
  .col li { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-line); }
  .svc { min-width: 0; }
  .price { flex: none; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .after { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  @media (min-width: 64rem) {
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-4); }
    .intro { grid-column: 1 / span 4; align-content: start; }
    .sheet { grid-column: 5 / span 8; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--space-5); padding: var(--space-5); }
    .after { grid-column: 5 / span 8; }
  }
  @media (max-width: 47.99rem) {
    .sheet { margin-inline: calc(-1 * var(--space-1)); padding-inline: var(--space-2); }
  }
</style>
