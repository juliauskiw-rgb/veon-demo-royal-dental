---
import Icon from "./Icon.astro";
import CallButton from "./CallButton.astro";
import FutureLink from "./FutureLink.astro";
import { nav, contacts, socials } from "../data/site";
const B = import.meta.env.BASE_URL;
---
<header class="site-header on-dark" data-rec="R-003">
  <div class="container bar">
    <a class="logo" href="#top">
      <picture>
        <source srcset={B + "images/logo-royal-dental.webp"} type="image/webp" />
        <img src={B + "images/logo-royal-dental.png"} width="279" height="70" alt="Royal Dental Digital Clinic, на початок сторінки" />
      </picture>
    </a>
    <nav class="nav" aria-label="Розділи сторінки">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="tools">
      <p class="lang"><span class="lang__current" aria-current="true">UA</span><FutureLink class="lang__en">EN</FutureLink></p>
      <a class="phone" href={contacts.phoneMain.href}>{contacts.phoneMain.label}</a>
      <CallButton withNumber={false} class="cta" />
      <a class="call-icon" href={contacts.phoneMain.href} aria-label={`Подзвонити ${contacts.phoneMain.label}`}><Icon name="phone" /></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" /><span class="menu-btn__label">Меню</span>
      </button>
    </div>
  </div>

  <div class="menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Меню" hidden data-menu>
    <div class="container menu__top">
      <span class="menu__title">Royal Dental</span>
      <button class="menu-btn" type="button" data-menu-close><Icon name="close" /><span class="menu-btn__label">Закрити</span></button>
    </div>
    <div class="container menu__body">
      <ul class="menu__nav">
        {nav.map((item) => <li><a href={item.href} data-menu-link>{item.label}</a></li>)}
      </ul>
      <ul class="menu__contacts">
        <li><a href={contacts.phoneMain.href}>{contacts.phoneMain.label}</a></li>
        <li><a href={contacts.phoneSecond.href}>{contacts.phoneSecond.label}</a></li>
        <li><a href={`mailto:${contacts.email}`}>{contacts.email}</a></li>
        <li><a href={socials.instagram.href} rel="noopener" target="_blank" data-rec="R-011,S-R002,MA-R002">Instagram {socials.instagram.handle}</a></li>
      </ul>
      <p class="lang"><span class="lang__current" aria-current="true">UA</span><FutureLink class="lang__en">EN</FutureLink></p>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--color-header); color: var(--color-on-dark); }
  .bar { display: flex; align-items: center; gap: var(--space-3); height: var(--header-h); }
  .logo { display: block; flex: none; border-radius: var(--radius); }
  .logo img { width: auto; height: 36px; }
  .nav { display: none; margin-inline: auto; }
  .nav ul { display: flex; gap: var(--space-3); list-style: none; }
  .nav a, .phone {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--color-on-dark); font-size: var(--text-xs); font-weight: 500; text-decoration: none;
    text-decoration-thickness: 1px; text-underline-offset: 0.35em;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .nav a:hover, .phone:hover { text-decoration: underline; }
  .nav a:active, .phone:active { color: var(--color-silver); }
  .nav a.is-current { text-decoration: underline; text-decoration-color: var(--color-silver); }
  .tools { display: flex; align-items: center; gap: var(--space-3); margin-left: auto; }
  .lang { display: none; align-items: center; gap: var(--space-2); font-size: var(--text-xs); }
  .lang__current { font-weight: 600; }
  .phone { display: none; white-space: nowrap; font-size: var(--text-s); font-weight: 600; }
  .tools :global(.cta) { display: none; min-height: 44px; font-size: var(--text-xs); }
  .call-icon, .menu-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-1);
    min-width: 44px; min-height: 44px; padding: 0 var(--space-1);
    background: none; border: 1px solid var(--color-silver); border-radius: var(--radius);
    color: var(--color-on-dark); cursor: pointer; text-decoration: none;
    transition: border-color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);
  }
  .call-icon { background: var(--color-accent); border-color: var(--color-accent); }
  .call-icon:hover { background: var(--color-accent-strong); }
  .menu-btn:hover { border-color: var(--color-on-dark); }
  .call-icon:active, .menu-btn:active { transform: translateY(1px); }
  .call-icon :global(svg), .menu-btn :global(svg) { width: 22px; height: 22px; }
  .menu-btn__label { font-size: var(--text-xs); font-weight: 500; }
  .menu-btn { display: none; }
  :global(.js) .menu-btn { display: inline-flex; }

  .menu { position: fixed; inset: 0; z-index: 60; background: var(--color-header); color: var(--color-on-dark); overflow-y: auto; opacity: 1; transition: opacity var(--dur-short) var(--ease-out); }
  .menu[hidden] { display: none; }
  .menu.is-entering { opacity: 0; }
  .menu__top { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); }
  .menu__title { font-family: var(--font-display); font-size: var(--text-m); }
  .menu__body { display: grid; gap: var(--space-4); padding-block: var(--space-4) var(--space-5); }
  .menu__nav { list-style: none; display: grid; }
  .menu__nav a { display: flex; align-items: center; min-height: 56px; font-family: var(--font-display); font-size: var(--text-l); line-height: 1.1; text-decoration: none; border-bottom: 1px solid var(--color-text-muted); }
  .menu__nav a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .menu__contacts { list-style: none; display: grid; gap: var(--space-1); }
  .menu__contacts a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-s); color: var(--color-silver); text-underline-offset: 0.3em; }
  .menu__contacts a:hover { color: var(--color-on-dark); }
  .menu .lang { display: flex; }

  @media (min-width: 48rem) {
    .phone { display: inline-flex; }
    .tools :global(.cta) { display: inline-flex; }
    .call-icon { display: none; }
  }
  @media (min-width: 76rem) {
    .nav + .tools { margin-left: 0; }
    .nav { display: block; }
    .lang { display: flex; }
    .menu-btn, :global(.js) .menu-btn { display: none; }
    .menu-btn__label { display: none; }
  }
  @media (max-width: 47.99rem) {
    .logo img { height: 32px; }
    .bar { gap: var(--space-2); }
    .tools { gap: var(--space-1); }
    .menu-btn__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .menu-btn { padding: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu.is-entering { opacity: 1; }
    .call-icon:active, .menu-btn:active { transform: none; }
  }
</style>
