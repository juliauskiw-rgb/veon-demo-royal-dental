---
import Icon from "./Icon.astro";
import { faq, nb } from "../data/site";
---
<section id="faq" class="section faq" data-rec="R-007">
  <div class="container grid">
    <h2>Питання перед першим візитом</h2>
    <div class="list">
      {faq.map((f) => (
        <details class="item">
          <summary><h3>{nb(f.q)}</h3><Icon name="plus" class="faq-icon" /></summary>
          <div class="answer">{f.a.map((p) => <p>{nb(p)}</p>)}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-block: var(--space-6); }
  .grid { display: grid; gap: var(--space-4); }
  .list { border-top: 1px solid var(--color-text); }
  .item { border-bottom: 1px solid var(--color-line); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    min-height: 64px; padding: var(--space-2) 0; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-size: var(--text-m); font-weight: 500; line-height: 1.3; transition: color var(--dur-micro) var(--ease-out); }
  summary:hover h3 { color: var(--color-accent); }
  summary:focus-visible { outline-offset: 2px; }
  summary :global(.faq-icon) { width: 22px; height: 22px; flex: none; transition: transform var(--dur-short) var(--ease-out); }
  .item[open] summary :global(.faq-icon) { transform: rotate(45deg); }
  .answer { display: grid; gap: var(--space-2); padding-bottom: var(--space-3); max-width: 62ch; color: var(--color-text-muted); }
  @media (min-width: 64rem) {
    .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--gap); align-items: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    summary :global(.faq-icon) { transition: none; }
  }
</style>
